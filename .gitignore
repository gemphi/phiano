# /----------------------------------------------------------------------------\
# | Phiano .gitignore - Rust, Web, Python, and Binary Artifact Exclusions      |
# \----------------------------------------------------------------------------/

# Rust Build & Target Artifacts
/target/
target*/
**/*.rs.bk
*.rlib
*.pdb
*.d
*.exe
*.dll
*.so
*.dylib

# Node / Vite / Web
node_modules/
web/node_modules/
web/dist/
web/.next/
web/build/
dist/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Personal / Machine-Local Workspaces & Reference Clones
jobs/
models/
refs/

# Large Model Weights & Downloader Outputs
*.gguf
*.gguf.tmp
*.safetensors
*.bin
*.onnx
*.pt
*.pth

# Large Dataset Binaries / Generated Chunks / Caches
data/manifold.chroma
data/memory.chroma
data/chunks/
data/definitions/
data/rust_book/
*.chroma
*.tmp

# Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# build sync tarball used by the remote toolchain
.sync/
data/evaluation.json
*.chroma.tmp
